# Optional: override which model each provider uses. The API key itself is
# never read from here - it's always supplied per-request by the browser
# (Settings), there is no server-side key fallback.
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-2.5-flash

# Any OpenRouter model slug. Non-Perplexity models get OpenRouter's web-search plugin enabled.
OPENROUTER_MODEL=perplexity/sonar
