# Optional, defaults to gpt-4o if unset.
OPENAI_MODEL=gpt-4o

# Optional, defaults to gemini-2.5-flash if unset.
GEMINI_MODEL=gemini-2.5-flash

# Optional, defaults to perplexity/sonar if unset. Any OpenRouter model slug works;
# non-Perplexity models get OpenRouter's web-search plugin enabled automatically.
OPENROUTER_MODEL=perplexity/sonar
